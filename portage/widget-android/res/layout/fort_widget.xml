<?xml version="1.0" encoding="utf-8"?>
<!-- Fort Énigma : widget de l'écran d'accueil -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fw_racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fort_widget_fond_nuit"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:text="@string/fort_widget_nom"
            android:textAllCaps="true"
            android:textColor="#F4D03F"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fw_jouer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/fort_widget_bouton"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="Jouer ▸"
            android:textColor="#1A1206"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/fw_etat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="serif"
        android:maxLines="1"
        android:text="🌙 Le Fort est fermé"
        android:textColor="#F3EAD3"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/fw_passage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:text="Cette nuit, on entre par la poterne de la mer 🌊"
        android:textColor="#E8DCC0"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/fw_foire"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:text="🎪 Derrière les remparts, la Foire secrète est ouverte"
        android:textColor="#C9B98F"
        android:textSize="12sp"
        android:textStyle="italic" />
</LinearLayout>
