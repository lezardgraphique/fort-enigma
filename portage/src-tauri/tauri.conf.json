{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fort Enigma",
  "version": "1.11.200",
  "identifier": "app.netlify.fortenigma",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fort Énigma — L’Appel du Gardien",
        "width": 1366,
        "height": 820,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0f121a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "PuzzleGame",
    "shortDescription": "Jeu d'énigmes : relève les épreuves du Gardien et ouvre le Coffre au Trésor.",
    "longDescription": "Fort Énigma — L'Appel du Gardien : des épreuves, des univers et un coffre à ouvrir, en solo ou entre amis. Jouable hors connexion ; la voix du Gardien et la sauvegarde partagée utilisent Internet.",
    "copyright": "Thomas Champeau",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
