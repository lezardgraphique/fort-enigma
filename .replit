# Le jeu est un fichier statique : on le sert tel quel.
run = "python3 -m http.server 8000"
entrypoint = "index.html"

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "python3 -m http.server 8000"]
deploymentTarget = "static"
publicDir = "."

[[ports]]
localPort = 8000
externalPort = 80
